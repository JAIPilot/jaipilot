{
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false,
    "include": [
      "plugins/jaipilot/.mcp.json",
      "plugins/jaipilot/.codex-plugin/plugin.json",
      "plugins/jaipilot/mcp/jaipilot-mcp.ts",
      "tests/jaipilot-mcp_test.ts",
      "deno.json"
    ]
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    },
    "include": [
      "plugins/jaipilot/mcp/jaipilot-mcp.ts",
      "tests/jaipilot-mcp_test.ts"
    ]
  },
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check plugins/jaipilot/mcp/jaipilot-mcp.ts tests/jaipilot-mcp_test.ts && deno test tests/jaipilot-mcp_test.ts && python3 scripts/validate-plugin.py"
  }
}
