{
  "name": "jaipilot",
  "version": "2.0.0",
  "description": "Local MCP server and Agent Skills for isolated Java test generation and verified OpenRewrite cleanup.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "jaipilot-mcp": "npm/bin/jaipilot-mcp.js"
  },
  "files": [
    "npm/bin/jaipilot-mcp.js",
    "npm/lib/launcher.js",
    "plugin/jaipilot",
    "install.sh",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "npm run validate:plugin && npm run test:npm",
    "validate:plugin": "node scripts/validate-plugin.mjs",
    "test:npm": "node --test npm/test/*.test.js",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run test:npm"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JAIPilot/jaipilot-cli.git"
  },
  "bugs": {
    "url": "https://github.com/JAIPilot/jaipilot-cli/issues"
  },
  "homepage": "https://github.com/JAIPilot/jaipilot-cli#readme",
  "keywords": [
    "java",
    "junit",
    "jacoco",
    "mcp",
    "agent-skills",
    "openrewrite",
    "testing",
    "code-quality",
    "coding-agents"
  ],
  "publishConfig": {
    "access": "public"
  }
}
