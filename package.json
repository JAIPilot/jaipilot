{
  "name": "jaipilot",
  "version": "1.0.15",
  "description": "Local OpenRewrite- and Codex-powered Java cleanup, unit-test generation, and JaCoCo coverage workflows.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "jaipilot": "npm/bin/jaipilot.js"
  },
  "files": [
    "npm/bin/jaipilot.js",
    "npm/lib/launcher.js",
    "install.sh",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "npm run test:npm",
    "test:npm": "node --test npm/test/*.test.js",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run test:npm"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JAIPilot/jaipilot-cli.git"
  },
  "bugs": {
    "url": "https://github.com/JAIPilot/jaipilot-cli/issues"
  },
  "homepage": "https://github.com/JAIPilot/jaipilot-cli#readme",
  "keywords": [
    "java",
    "junit",
    "jacoco",
    "codex",
    "testing",
    "code-quality",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  }
}
