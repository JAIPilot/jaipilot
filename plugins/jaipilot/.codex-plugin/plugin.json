{
  "name": "jaipilot",
  "version": "5.4.1",
  "description": "Java review, testing, cleanup, modernization, performance, and opt-in remote execution for coding agents.",
  "author": {
    "name": "JAIPilot",
    "url": "https://github.com/JAIPilot"
  },
  "homepage": "https://github.com/JAIPilot/jaipilot#readme",
  "repository": "https://github.com/JAIPilot/jaipilot",
  "license": "MIT",
  "keywords": [
    "java",
    "junit",
    "testing",
    "code-review",
    "openrewrite",
    "refactoring",
    "performance",
    "code-quality",
    "remote-execution"
  ],
  "skills": "./skills/",
  "mcpServers": {
    "jaipilot-remote": {
      "type": "stdio",
      "command": "deno",
      "args": [
        "run",
        "--quiet",
        "--allow-env=JAIPILOT_CLOUD_API_URL,JAIPILOT_CLOUD_TRIGGER_SECRET",
        "--allow-net=otxfylhjrlaesjagfhfi.supabase.co",
        "mcp/jaipilot-mcp.ts"
      ],
      "cwd": ".",
      "env": {
        "JAIPILOT_CLOUD_API_URL": "https://otxfylhjrlaesjagfhfi.supabase.co/functions/v1/jaipilot-cloud"
      },
      "env_vars": ["JAIPILOT_CLOUD_TRIGGER_SECRET"]
    }
  },
  "interface": {
    "displayName": "JAIPilot",
    "shortDescription": "Verified Java engineering workflows",
    "longDescription": "Make Java changes smaller, cleaner, faster, and easier to verify through meaningful tests, safe cleanup, measured performance work, compatible modernization, and optional exact-commit remote execution.",
    "developerName": "JAIPilot",
    "category": "Productivity",
    "capabilities": ["Interactive"],
    "websiteURL": "https://github.com/JAIPilot/jaipilot",
    "privacyPolicyURL": "https://github.com/JAIPilot/jaipilot/blob/main/PRIVACY.md",
    "termsOfServiceURL": "https://github.com/JAIPilot/jaipilot/blob/main/TERMS.md",
    "defaultPrompt": [
      "Optimize my current Java change without changing its behavior.",
      "Add meaningful tests for this Java behavior and report fresh coverage evidence.",
      "Run this committed Java build or benchmark on disposable remote hardware."
    ],
    "brandColor": "#2457D6",
    "logo": "./assets/jaipilot-logo.svg",
    "logoDark": "./assets/jaipilot-logo-dark.svg"
  }
}
