{
  "name": "jaipilot",
  "version": "5.3.0",
  "description": "Java engineering skills with opt-in remote build and test execution.",
  "author": {
    "name": "JAIPilot",
    "url": "https://github.com/JAIPilot"
  },
  "homepage": "https://github.com/JAIPilot/jaipilot#readme",
  "repository": "https://github.com/JAIPilot/jaipilot",
  "license": "MIT",
  "keywords": [
    "java",
    "junit",
    "testing",
    "openrewrite",
    "refactoring",
    "code-quality",
    "remote-execution"
  ],
  "skills": "./skills/",
  "mcpServers": {
    "jaipilot-remote": {
      "type": "stdio",
      "command": "deno",
      "args": [
        "run",
        "--quiet",
        "--allow-env=JAIPILOT_CLOUD_API_URL,JAIPILOT_CLOUD_TRIGGER_SECRET",
        "--allow-net=otxfylhjrlaesjagfhfi.supabase.co",
        "mcp/jaipilot-mcp.ts"
      ],
      "cwd": ".",
      "env": {
        "JAIPILOT_CLOUD_API_URL": "https://otxfylhjrlaesjagfhfi.supabase.co/functions/v1/jaipilot-cloud"
      },
      "env_vars": ["JAIPILOT_CLOUD_TRIGGER_SECRET"]
    }
  },
  "interface": {
    "displayName": "JAIPilot",
    "shortDescription": "Java skills with remote execution",
    "longDescription": "Guide coding agents through disciplined Java review, tests, cleanup, modernization, and performance work, with optional disposable remote hardware for exact committed GitHub revisions.",
    "developerName": "JAIPilot",
    "category": "Productivity",
    "capabilities": ["Interactive"],
    "websiteURL": "https://github.com/JAIPilot/jaipilot",
    "privacyPolicyURL": "https://github.com/JAIPilot/jaipilot/blob/main/PRIVACY.md",
    "termsOfServiceURL": "https://github.com/JAIPilot/jaipilot/blob/main/TERMS.md",
    "defaultPrompt": [
      "Review and verify my current Java diff.",
      "Raise meaningful per-class Java test coverage toward at least 80%.",
      "Safely clean, consolidate, modernize, or optimize this Java project."
    ],
    "brandColor": "#2457D6",
    "logo": "./assets/jaipilot-logo.svg",
    "logoDark": "./assets/jaipilot-logo-dark.svg"
  }
}
