#!/usr/bin/env sh
set -eu

if [ -n "${JAIPILOT_TOOLKIT_EXECUTABLE:-}" ]; then
  exec "$JAIPILOT_TOOLKIT_EXECUTABLE" "$@"
fi

PLUGIN_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
VERSION="4.0.8"

if [ -n "${JAIPILOT_RUNTIME_HOME:-}" ]; then
  APP_DIR=$JAIPILOT_RUNTIME_HOME
elif [ -n "${XDG_DATA_HOME:-}" ]; then
  APP_DIR="$XDG_DATA_HOME/jaipilot"
else
  APP_DIR="$HOME/.local/share/jaipilot"
fi

if [ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/java" ]; then
  JAVA_COMMAND="$JAVA_HOME/bin/java"
elif command -v java >/dev/null 2>&1; then
  JAVA_COMMAND=$(command -v java)
else
  echo "JAIPilot requires Java 17 or newer in JAVA_HOME or PATH." >&2
  exit 1
fi

JAVA_SPEC=$(
  "$JAVA_COMMAND" -XshowSettings:properties -version 2>&1 \
    | sed -n 's/^[[:space:]]*java\.specification\.version = //p' \
    | head -n 1
)
case "$JAVA_SPEC" in
  1.*) JAVA_MAJOR=${JAVA_SPEC#1.}; JAVA_MAJOR=${JAVA_MAJOR%%.*} ;;
  *) JAVA_MAJOR=${JAVA_SPEC%%.*} ;;
esac
case "$JAVA_MAJOR" in
  ''|*[!0-9]*)
    echo "JAIPilot could not determine the Java version from $JAVA_COMMAND." >&2
    exit 1
    ;;
esac
if [ "$JAVA_MAJOR" -lt 17 ]; then
  echo "JAIPilot requires Java 17 or newer; found Java $JAVA_SPEC." >&2
  exit 1
fi

PAYLOAD="$APP_DIR/versions/$VERSION/jaipilot-toolkit.jar"
if [ ! -f "$PAYLOAD" ]; then
  if [ -n "${JAIPILOT_BOOTSTRAP_ARTIFACT_URL:-}" ] \
    || [ -n "${JAIPILOT_BOOTSTRAP_CHECKSUM_URL:-}" ]; then
    [ -n "${JAIPILOT_BOOTSTRAP_ARTIFACT_URL:-}" ] \
      && [ -n "${JAIPILOT_BOOTSTRAP_CHECKSUM_URL:-}" ] || {
        echo "JAIPilot bootstrap artifact and checksum overrides must be set together." >&2
        exit 1
      }
    "$PLUGIN_ROOT/libexec/install.sh" \
      --version "$VERSION" \
      --app-dir "$APP_DIR" \
      --artifact-url "$JAIPILOT_BOOTSTRAP_ARTIFACT_URL" \
      --checksum-url "$JAIPILOT_BOOTSTRAP_CHECKSUM_URL"
  else
    "$PLUGIN_ROOT/libexec/install.sh" --version "$VERSION" --app-dir "$APP_DIR"
  fi
fi

[ -f "$PAYLOAD" ] || {
  echo "JAIPilot $VERSION plugin payload was not installed at $PAYLOAD" >&2
  exit 1
}

exec "$JAVA_COMMAND" -jar "$PAYLOAD" "$@"
