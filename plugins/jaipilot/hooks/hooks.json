{
  "description": "Refresh current Java quality after agent Git commits and require fresh proof for changed production diffs.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-use.sh\"",
            "timeout": 60,
            "statusMessage": "Analyzing committed Java"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/jaipilot\" hook-stop --project .",
            "timeout": 60,
            "statusMessage": "Checking changed Java proof"
          }
        ]
      }
    ]
  }
}
