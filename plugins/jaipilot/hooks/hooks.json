{
  "description": "Initialize current repository evidence, refresh direct agent commits, and require exact Java diff proof.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "jaipilot_plugin_root=\"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}\"; [ -n \"$jaipilot_plugin_root\" ] || exit 0; [ -x \"$jaipilot_plugin_root/hooks/session-start.sh\" ] || exit 0; exec \"$jaipilot_plugin_root/hooks/session-start.sh\"",
            "timeout": 10,
            "statusMessage": "Initializing JAIPilot evidence"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jaipilot_plugin_root=\"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}\"; [ -n \"$jaipilot_plugin_root\" ] || exit 0; [ -x \"$jaipilot_plugin_root/hooks/post-tool-use.sh\" ] || exit 0; exec \"$jaipilot_plugin_root/hooks/post-tool-use.sh\"",
            "timeout": 300,
            "statusMessage": "Refreshing committed Java evidence"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jaipilot_plugin_root=\"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}\"; [ -n \"$jaipilot_plugin_root\" ] || exit 0; [ -x \"$jaipilot_plugin_root/hooks/stop.sh\" ] || exit 0; exec \"$jaipilot_plugin_root/hooks/stop.sh\"",
            "timeout": 300,
            "statusMessage": "Checking exact Java diff proof"
          }
        ]
      }
    ]
  }
}
